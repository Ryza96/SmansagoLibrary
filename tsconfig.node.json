{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out",
    "declaration": true,
    "composite": true
  },
  "include": [
    "electron/main/**/*",
    "electron/preload/**/*",
    "electron/ipc/**/*",
    "src/shared/**/*",
    "src/services/strategies/**/*",
    "src/services/MatchingEngineService.ts",
    "src/services/DummyMatchStrategies.ts",
    "src/services/DummyMatchProviders.ts",
    "src/services/MatchProviders.ts",
    "src/types/import.ts",
    "src/main/**/*",
    "electron.vite.config.ts"
  ]
}
