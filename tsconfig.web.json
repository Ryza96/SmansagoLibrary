{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true
  },
  "include": [
    "src/renderer/**/*",
    "src/components/**/*",
    "src/pages/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/routes/**/*",
    "src/shared/**/*"
  ]
}
