generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Allowed values:
// MemberType: SISWA | GURU | UMUM
// Gender: LAKI_LAKI | PEREMPUAN
// MemberStatus: ACTIVE | INACTIVE
// BookCopyStatus: AVAILABLE | BORROWED | LOST | REMOVED
// EducationLevel: X | XI | XII

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes           Class[]
  memberEnrollments MemberEnrollment[]
  promotionRunsFrom PromotionRun[] @relation("PromotionRunFromYear")
  promotionRunsTo   PromotionRun[] @relation("PromotionRunToYear")
}

model Curriculum {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
}

model Class {
  id              String   @id @default(uuid())
  academicYearId  String
  curriculumId    String
  educationLevel  String
  parallel        String
  homeroomTeacher String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id])
  curriculum       Curriculum   @relation(fields: [curriculumId], references: [id])
  members          Member[]
  memberEnrollments MemberEnrollment[]

  @@unique([academicYearId, curriculumId, educationLevel, parallel])
  @@index([academicYearId])
  @@index([curriculumId])
}

// Academic Context — SSOT penempatan anggota di kelas per tahun ajaran (RFC §2.1).
// status: ACTIVE | PROMOTED | REPEATED | REDISTRIBUTED | TRANSFERRED | DROPPED | GRADUATED
// (tanpa DEFAULT — ditentukan Service di Work Order berikutnya)
model MemberEnrollment {
  id             String   @id @default(uuid())
  memberId       String
  classId        String
  academicYearId String
  status         String
  enrolledAt     DateTime @default(now())
  leftAt         DateTime?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member       Member       @relation(fields: [memberId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([memberId, academicYearId])
  @@index([memberId, status])
  @@index([classId])
  @@index([academicYearId])
  @@index([status])
}

// Academic Context — audit operasi massal / promosi (RFC §2.2, §10).
// mode: AUTOMATIC | MAPPING | BULK_EDIT; status: SUCCESS | PARTIAL | FAILED
// (tanpa DEFAULT — ditentukan Service di Work Order berikutnya)
model PromotionRun {
  id         String   @id @default(uuid())
  fromYearId String
  toYearId   String
  mode       String
  runBy      String?
  status     String
  summary    String?
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  fromYear AcademicYear      @relation("PromotionRunFromYear", fields: [fromYearId], references: [id])
  toYear   AcademicYear      @relation("PromotionRunToYear", fields: [toYearId], references: [id])
  items    PromotionRunItem[]

  @@index([fromYearId])
  @@index([toYearId])
  @@index([status])
}

model PromotionRunItem {
  id             String  @id @default(uuid())
  promotionRunId String
  memberId       String
  sourceClassId  String
  targetClassId  String?
  outcome        String
  message        String?

  promotionRun PromotionRun @relation(fields: [promotionRunId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])

  @@index([promotionRunId])
  @@index([memberId])
  @@index([outcome])
}

model Author {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@index([name])
}

model Publisher {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@index([name])
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@index([name])
}

model Member {
  id           String    @id @default(uuid())
  memberNumber String    @unique @map("number")
  memberType   String?
  fullName     String
  gender       String?
  nisn         String?   @unique
  nip          String?   @unique
  nuptk        String?   @unique
  nik          String?   @unique
  birthPlace   String?   @map("birthplace")
  birthDate    DateTime?
  address      String?
  phone        String?
  email        String?
  classId      String?
  status       String    @default("INACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  class             Class?    @relation(fields: [classId], references: [id])
  borrows           Borrow[]
  memberEnrollments MemberEnrollment[]
  promotionRunItems PromotionRunItem[]

  @@index([fullName])
  @@index([status])
  @@index([classId])
}

model Book {
  id              String   @id @default(uuid())
  isbn            String?  @unique
  title           String
  authorId        String?
  publisherId     String?
  categoryId      String?
  publicationYear Int?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author     Author?    @relation(fields: [authorId], references: [id])
  publisher  Publisher? @relation(fields: [publisherId], references: [id])
  category   Category?  @relation(fields: [categoryId], references: [id])
  bookCopies BookCopy[]

  @@index([title])
  @@index([isbn])
}

model BookCopy {
  id                      String    @id @default(uuid())
  bookId                  String
  inventoryNumber         String    @unique
  barcode                 String    @unique
  condition               String    @default("GOOD")
  status                  String    @default("AVAILABLE")
  shelfLocation           String
  acquisitionDate         DateTime?
  acquisitionSource       String?
  acquisitionCost         Int?
  acquisitionSourceDetail String?
  acquisitionNotes        String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  book          Book           @relation(fields: [bookId], references: [id])
  borrowDetails BorrowDetail[]
  assetEvents   AssetEvent[]

  @@index([status])
  @@index([shelfLocation])
}

model AssetEvent {
  id         String   @id @default(uuid())
  bookCopyId String
  eventType  String
  actorType  String
  actorId    String?
  metadata   String?
  notes      String?
  occurredAt DateTime @default(now())

  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])

  @@index([bookCopyId])
  @@index([eventType])
}

model Borrow {
  id           String    @id @default(uuid())
  borrowNumber String    @unique
  memberId     String
  borrowDate   DateTime
  dueDate      DateTime
  returnDate   DateTime?
  notes        String?
  memberName   String
  memberNumber String
  className    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  member  Member         @relation(fields: [memberId], references: [id])
  details BorrowDetail[]

  @@index([memberId])
  @@index([borrowNumber])
}

model BorrowDetail {
  id            String    @id @default(uuid())
  borrowId      String
  bookCopyId    String
  returnedAt    DateTime?
  conditionBack String?
  note          String?
  bookTitle     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  borrow   Borrow   @relation(fields: [borrowId], references: [id])
  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])

  @@index([borrowId])
  @@index([bookCopyId])
}

// Auth context — identitas admin tunggal (RFC_AUTH_ARCHITECTURE.md §2).
// Invariant "satu admin" dijaga di Service layer (SQLite tanpa partial unique index).
// username: disimpan sesuai input pengguna — hanya trim(), kapitalisasi dipertahankan
// (REV-1); login case-insensitive via lookup Service (findByUsernameCaseInsensitive).
model Admin {
  id                String    @id @default(uuid())
  username          String    @unique
  passwordHash      String
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  adminSessions AdminSession[]

  @@index([username])
}

// Auth context — session admin yang di-persist (RFC_AUTH_SESSION_PERSISTENCE.md, AUTH-7).
// Opsi A: tabel SQLite agar session bertahan setelah restart aplikasi (TTL 24 jam absolute).
// - Single admin → maksimal satu baris valid per admin (open() mengganti row lama).
// - sessionId = token opaque 32-byte base64url, TIDAK pernah keluar dari Main (hanya
//   disimpan di DB; renderer hanya menerima boolean dari auth:status).
// - logout menghapus baris; row yang expire di-prune (deleteExpired) saat login.
model AdminSession {
  id        String   @id @default(uuid())
  sessionId String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
  @@index([expiresAt])
}

// Infrastructure — Inventory Number Allocator
// BUKAN domain model. Infrastructure component untuk mengalokasikan nomor inventaris.
model InventorySequence {
  id         String   @id
  prefix     String   @default("INV")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Settings — Singleton configuration untuk seluruh aplikasi.
// Hanya ada SATU row. Repository bertanggung jawab memastikan row tersedia.
model Setting {
  id                   String   @id @default(uuid())
  // Identity
  libraryName          String   @default("APLibrary")
  schoolName           String   @default("")
  address              String   @default("")
  phone                String   @default("")
  email                String   @default("")
  website              String   @default("")
  logoPath             String   @default("")
  // Responsible Person
  principalName        String   @default("")
  principalNip         String   @default("")
  librarianName        String   @default("")
  librarianNip         String   @default("")
  // Borrowing
  defaultBorrowDays    Int      @default(7)
  maxBorrowBooks       Int      @default(5)
  lateFee              Int      @default(1000)
  allowRenewal         Boolean  @default(true)
  // Inventory
  inventoryPrefix      String   @default("INV")
  defaultShelfLocation String   @default("")
  barcodeFormat        String   @default("BC-XXXXXXXXXX")
  // Report
  reportPaperSize      String   @default("A4")
  reportDateFormat     String   @default("DD/MM/YYYY")
  reportSigner         String   @default("")
  // Print
  borrowCardPrinter    String   @default("")
  // System
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
