generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Allowed values:
// MemberType: SISWA | GURU | UMUM
// Gender: LAKI_LAKI | PEREMPUAN
// MemberStatus: ACTIVE | INACTIVE
// BookCopyStatus: AVAILABLE | BORROWED | LOST | REMOVED
// EducationLevel: X | XI | XII

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
}

model Curriculum {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Class[]
}

model Class {
  id              String   @id @default(uuid())
  academicYearId  String
  curriculumId    String
  educationLevel  String
  parallel        String
  homeroomTeacher String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  curriculum   Curriculum   @relation(fields: [curriculumId], references: [id])
  members      Member[]

  @@unique([academicYearId, curriculumId, educationLevel, parallel])
  @@index([academicYearId])
  @@index([curriculumId])
}

model Author {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@index([name])
}

model Publisher {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@index([name])
}

model Category {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@index([name])
}

model Member {
  id           String    @id @default(uuid())
  memberNumber String    @unique @map("number")
  memberType   String?
  fullName     String
  gender       String?
  nisn         String?   @unique
  nip          String?   @unique
  nuptk        String?   @unique
  nik          String?   @unique
  birthPlace   String?   @map("birthplace")
  birthDate    DateTime?
  address      String?
  phone        String?
  email        String?
  classId      String?
  status       String    @default("INACTIVE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  class   Class?   @relation(fields: [classId], references: [id])
  borrows Borrow[]

  @@index([fullName])
  @@index([status])
  @@index([classId])
}

model Book {
  id              String   @id @default(uuid())
  isbn            String?  @unique
  title           String
  authorId        String?
  publisherId     String?
  categoryId      String?
  publicationYear Int?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author     Author?    @relation(fields: [authorId], references: [id])
  publisher  Publisher? @relation(fields: [publisherId], references: [id])
  category   Category?  @relation(fields: [categoryId], references: [id])
  bookCopies BookCopy[]

  @@index([title])
  @@index([isbn])
}

model BookCopy {
  id              String    @id @default(uuid())
  bookId          String
  inventoryNumber String    @unique
  barcode         String    @unique
  condition       String    @default("GOOD")
  status          String    @default("AVAILABLE")
  shelfLocation   String
  acquisitionDate DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  book          Book           @relation(fields: [bookId], references: [id])
  borrowDetails BorrowDetail[]
  assetEvents   AssetEvent[]

  @@index([status])
  @@index([shelfLocation])
}

model AssetEvent {
  id          String   @id @default(uuid())
  bookCopyId  String
  eventType   String
  actorType   String
  actorId     String?
  metadata    String?
  notes       String?
  occurredAt  DateTime @default(now())

  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])

  @@index([bookCopyId])
  @@index([eventType])
}

model Borrow {
  id           String    @id @default(uuid())
  borrowNumber String    @unique
  memberId     String
  borrowDate   DateTime
  dueDate      DateTime
  returnDate   DateTime?
  notes        String?
  memberName   String
  memberNumber String
  className    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  member  Member         @relation(fields: [memberId], references: [id])
  details BorrowDetail[]

  @@index([memberId])
  @@index([borrowNumber])
}

model BorrowDetail {
  id            String    @id @default(uuid())
  borrowId      String
  bookCopyId    String
  returnedAt    DateTime?
  conditionBack String?
  note          String?
  bookTitle     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  borrow   Borrow   @relation(fields: [borrowId], references: [id])
  bookCopy BookCopy @relation(fields: [bookCopyId], references: [id])

  @@index([borrowId])
  @@index([bookCopyId])
}

// Infrastructure — Inventory Number Allocator
// BUKAN domain model. Infrastructure component untuk mengalokasikan nomor inventaris.
model InventorySequence {
  id         String   @id
  prefix     String   @default("INV")
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// Settings — Singleton configuration untuk seluruh aplikasi.
// Hanya ada SATU row. Repository bertanggung jawab memastikan row tersedia.
model Setting {
  id              String   @id @default(uuid())
  // Identity
  libraryName     String   @default("APLibrary")
  schoolName      String   @default("")
  address         String   @default("")
  phone           String   @default("")
  email           String   @default("")
  website         String   @default("")
  logoPath        String   @default("")
  // Responsible Person
  principalName   String   @default("")
  principalNip    String   @default("")
  librarianName   String   @default("")
  librarianNip    String   @default("")
  // Borrowing
  defaultBorrowDays Int    @default(7)
  maxBorrowBooks    Int    @default(5)
  lateFee           Int    @default(1000)
  allowRenewal      Boolean @default(true)
  // Inventory
  inventoryPrefix        String @default("INV")
  defaultShelfLocation   String @default("")
  barcodeFormat          String @default("BC-XXXXXXXXXX")
  // Report
  reportPaperSize  String   @default("A4")
  reportDateFormat String   @default("DD/MM/YYYY")
  reportSigner     String   @default("")
  // System
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
